{
  "name": "@serena/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "build": "esbuild src/index.ts src/seed.ts src/alta-inicial.ts src/guardia-prueba.ts --bundle --platform=node --format=esm --target=node22 --external:@anthropic-ai/sdk --external:express --external:helmet --external:jose --external:stripe --external:zod --outdir=dist",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "guardia:prueba": "tsx --env-file-if-exists=../../.env src/guardia-prueba.ts",
    "alta": "node --env-file-if-exists=../../.env dist/alta-inicial.js",
    "sms:prueba": "tsx --env-file-if-exists=../../.env src/sms/probar.ts",
    "alertas:prueba": "tsx --env-file-if-exists=../../.env src/alertas-prueba.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@serena/domain": "*",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.0",
    "stripe": "^22.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "esbuild": "^0.25.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.0",
    "tsx": "^4.19.0"
  }
}
