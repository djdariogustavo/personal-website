# SERENA Companion · variables de entorno (copiar a .env)

# --- Obligatorias en producción ---
# 32 bytes en base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERENA_MASTER_KEY=
SERENA_JWT_SECRET=
NODE_ENV=development
PORT=8787
# URL pública de la app (redirecciones de pago y enlaces)
SERENA_PUBLIC_URL=http://localhost:5173
# SERENA_DB_PATH=/ruta/absoluta/serena.db   (por defecto: serena-companion/data/serena.db)

# --- Acompañante (Claude). Sin clave, responde el acompañante básico con frases fijas. ---
ANTHROPIC_API_KEY=
SERENA_COMPANION_MODEL=claude-opus-5

# --- SMS con Twilio (segundo factor, recuperación y avisos de seguridad) ---
# Obligatorio en producción. En desarrollo se usa solo con SERENA_SMS=twilio (si no, el código va a la consola).
# API Key restringida (Messaging: Messages Create; Verify: verification y verification-check Create).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Remitente: número (E.164, p. ej. +1…) o, en su lugar, un Messaging Service (MG…)
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# SERENA_SMS=twilio

# --- Guardia de la faena (PEC). Sin URL, los avisos se registran en la consola. ---
SERENA_GUARD_WEBHOOK_URL=
SERENA_GUARD_WEBHOOK_SECRET=

# --- Servicio de pago ---
# Stripe (USD): clave secreta, secreto del webhook y precios por plan (price_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS={"faena-mensual":"price_xxx","faena-anual":"price_yyy"}
# Mercado Pago (ARS o CLP)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=ARS
# Pasarela de prueba (siempre activa en desarrollo; en producción solo si se pide)
SERENA_PAYMENTS_SANDBOX=false
# Catálogo de planes (JSON). Si no se define, se usan los planes de ejemplo.
# SERENA_PLANS_JSON=[...]

# --- Configuración remota (umbrales, líneas de ayuda, etc.) como JSON parcial ---
# SERENA_CONFIG_JSON={"escaneo":{"duracionS":45}}

# --- Frontend (Vite) ---
# ninguno | simulado | sdk   (por defecto: simulado en desarrollo, ninguno en producción)
# VITE_SCAN_PROVIDER=ninguno
